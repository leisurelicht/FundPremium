/* app.wxss - 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial,
    sans-serif;
  font-size: 28rpx;
  color: #1a1a2e;
  background: #f5f6fa;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/*
 * 关键：小程序默认 box-sizing 是 content-box，
 * 元素设置 padding 后会额外撑宽，导致横向溢出屏幕。
 * 统一改为 border-box。
 */
view,
scroll-view,
text,
image,
button,
input,
textarea,
swiper,
swiper-item,
navigator {
  box-sizing: border-box;
}

/* 全局滚动条隐藏 */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  background: transparent;
}