/* pages/detail/detail.wxss - ETF详情页样式 */

/* ========== 基础 ========== */
.page-scroll {
  height: 100vh;
  background: #f5f6fa;
}

.safe-bottom {
  height: 80rpx;
}

/* ========== 加载中 ========== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 300rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #e8ecf1;
  border-top-color: #4d8af0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 28rpx;
  font-size: 28rpx;
  color: #999;
}

/* ========== 错误 ========== */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 240rpx;
}

.error-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
  white-space: pre-line;
  text-align: center;
  line-height: 1.7;
  padding: 0 48rpx;
}

.retry-btn {
  padding: 16rpx 56rpx;
  background: #4d8af0;
  border-radius: 40rpx;
}

.retry-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* ========== 头部指标卡 ========== */
.metrics-card {
  margin: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.title-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.etf-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a2e;
}

.etf-code {
  font-size: 24rpx;
  color: #999;
  font-family: 'SF Mono', 'Menlo', monospace;
}

/* 费率标签（header 右侧） */
.fee-badge {
  background: #f5f6fa;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

.fee-text {
  font-size: 24rpx;
  color: #8a90a0;
  font-weight: 500;
}

/* 2x3 指标网格 */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  margin-bottom: 24rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #f8f9fc;
}

.metric-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 22rpx 12rpx;
  position: relative;
}

.metric-cell::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 1rpx;
  background: #e8ecf1;
}

.metric-cell:nth-child(3n)::after {
  display: none;
}

.metric-cell.highlight {
  background: transparent;
}

.cell-label {
  font-size: 22rpx;
  color: #b0b5c0;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.cell-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
  font-family: 'DIN', 'SF Pro Display', sans-serif;
}

.cell-value.up { color: #e8453c; }
.cell-value.down { color: #1cad6d; }

.premium-tag {
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.premium-tag.premium-high { background: #fde8e7; }
.premium-tag.premium-high .cell-value { color: #e8453c; }
.premium-tag.premium { background: #fff3eb; }
.premium-tag.premium .cell-value { color: #f06b32; }
.premium-tag.discount { background: #e6f7f0; }
.premium-tag.discount .cell-value { color: #1cad6d; }
.premium-tag.flat { background: #f0f2f8; }
.premium-tag.flat .cell-value { color: #888; }

/* 溢折率：与其他指标一致，仅用彩色文字 */
.cell-value.premium-val {
  font-weight: 800;
  font-size: 32rpx;
}

.cell-value.premium-val.premium-high { color: #e8453c; }
.cell-value.premium-val.premium      { color: #f06b32; }
.cell-value.premium-val.discount     { color: #1cad6d; }
.cell-value.premium-val.flat         { color: #888; }

/* 额外指标行 */
.extra-metrics {
  display: flex;
  gap: 32rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f2f8;
}

.extra-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.extra-label {
  font-size: 22rpx;
  color: #b0b5c0;
  letter-spacing: 1rpx;
}

.extra-val {
  font-size: 26rpx;
  font-weight: 600;
  color: #3a3a4a;
  font-family: 'DIN', 'SF Pro Display', sans-serif;
}

.extra-val.up { color: #e8453c; }
.extra-val.down { color: #1cad6d; }

/* ========== K线图区域 ========== */
.chart-section {
  margin: 0 24rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.chart-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.chart-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.chart-subtitle {
  font-size: 22rpx;
  color: #b0b5c0;
}

/* 图表切换 */
.chart-tabs {
  display: flex;
  flex-direction: row;
  background: #f2f4f8;
  border-radius: 10rpx;
  padding: 4rpx;
  margin-bottom: 16rpx;
}

.chart-tab {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #8a90a0;
  padding: 10rpx 0;
  border-radius: 8rpx;
  transition: background 0.2s ease, color 0.2s ease;
}

.chart-tab.active {
  background: #ffffff;
  color: #1a1a2e;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.chart-container {
  width: 100%;
  height: 560rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #fafbfd;
}

.chart-placeholder {
  width: 100%;
  height: 560rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  font-size: 28rpx;
  color: #b0b5c0;
}