/* pages/index/index.wxss - 主列表页样式 */

/* ========== 基础布局 ========== */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100%;
  background: #f5f6fa;
  overflow-x: hidden;
}

/* ========== Tab 栏 ========== */
.tab-bar {
  display: flex;
  background: #1a1a2e;
  padding: 0 32rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 0 0;
  position: relative;
  cursor: pointer;
}

.tab-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.55);
  font-weight: 500;
  letter-spacing: 2rpx;
  transition: color 0.25s ease;
}

.tab-item.active .tab-text {
  color: #ffffff;
  font-weight: 700;
}

.tab-indicator {
  width: 48rpx;
  height: 6rpx;
  background: #4d8af0;
  border-radius: 3rpx;
  margin-top: 12rpx;
  animation: slideIn 0.3s ease;
}

@keyframes slideIn {
  from { opacity: 0; transform: scaleX(0.6); }
  to   { opacity: 1; transform: scaleX(1); }
}

/* ========== 滚动列表 ========== */
.list-scroll {
  flex: 1;
  width: 100%;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* ========== 加载中 ========== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #e8ecf1;
  border-top-color: #4d8af0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 28rpx;
  font-size: 28rpx;
  color: #999;
}

/* ========== 错误 ========== */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.error-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
  white-space: pre-line;
  line-height: 1.7;
  text-align: center;
  padding: 0 40rpx;
}

.retry-btn {
  padding: 16rpx 56rpx;
  background: #4d8af0;
  border-radius: 40rpx;
}

.retry-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* ========== ETF 卡片 ========== */
.card-list {
  display: flex;
  flex-direction: column;
}

.etf-card {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.035);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  overflow: hidden;
}

.etf-card:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 第一行：左名称+代码 / 右价格+涨跌 */
.card-top {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.card-left {
  flex: 1 1 0;
  min-width: 0;
  margin-right: 20rpx;
  overflow: hidden;
}

.fund-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 40rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
}

.code-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.fund-code-inline {
  font-size: 21rpx;
  color: #fff;
  background: #9aa0b0;
  font-family: 'SF Mono', 'Menlo', monospace;
  font-weight: 600;
  line-height: 1.3;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  letter-spacing: 1rpx;
}

/* 申购状态微标 */
.sub-badge {
  margin-left: 8rpx;
  padding: 0 8rpx;
  border-radius: 4rpx;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.5;
  vertical-align: middle;
}

.sub-suspended {
  background: #fde8e7;
  color: #e8453c;
}

.sub-limited {
  background: #fff4e5;
  color: #f0883a;
}

.sub-open {
  background: #e6f7f0;
  color: #1cad6d;
}

/* 右侧价格区 */
.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex: 0 0 auto;
  max-width: 45%;
}

.price-value {
  font-size: 44rpx;
  font-weight: 800;
  font-family: 'DIN', 'SF Pro Display', sans-serif;
  letter-spacing: -1rpx;
  color: #1a1a2e;
  line-height: 1.1;
  white-space: nowrap;
  text-align: right;
}

.price-value.up   { color: #e8453c; }
.price-value.down { color: #1cad6d; }
.price-value.flat { color: #1a1a2e; }

.change-badge {
  margin-top: 4rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.change-badge.up   { background: #fde8e7; }
.change-badge.down { background: #e6f7f0; }
.change-badge.flat { background: #f0f2f8; }

.change-text {
  font-size: 24rpx;
}

.change-badge.up .change-text   { color: #e8453c; }
.change-badge.down .change-text { color: #1cad6d; }
.change-badge.flat .change-text { color: #888; }

/* 第二行：指标条 */
.card-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-top: 14rpx;
  border-top: 1rpx solid #f2f4f8;
}

.metrics-row {
  display: flex;
  flex-direction: row;
  flex: 1;
  min-width: 0;
}

.metric-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-right: 24rpx;
}

.metric-item:last-child {
  margin-right: 0;
}

.metric-label {
  font-size: 20rpx;
  color: #b0b5c0;
  letter-spacing: 0.5rpx;
}

.metric-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #3a3a4a;
  font-family: 'DIN', 'SF Pro Display', sans-serif;
}

/* 溢折率内联微标 */
.premium-inline {
  padding: 0 8rpx;
  border-radius: 4rpx;
  display: inline-block;
}
.premium-inline-premium-high { background: #fde8e7; }
.premium-inline-premium-high .premium-val { color: #e8453c; }
.premium-inline-premium       { background: #fff3eb; }
.premium-inline-premium .premium-val       { color: #f06b32; }
.premium-inline-discount      { background: #e6f7f0; }
.premium-inline-discount .premium-val      { color: #1cad6d; }
.premium-inline-flat          { background: #f0f2f8; }
.premium-inline-flat .premium-val          { color: #888; }

.premium-val {
  font-size: 24rpx;
  font-weight: 700;
  font-family: 'DIN', 'SF Pro Display', sans-serif;
}

.arrow-icon {
  margin-left: 12rpx;
  font-size: 32rpx;
  color: #d0d4dc;
  font-weight: 300;
  flex-shrink: 0;
}

/* ========== 底部更新 ========== */
.update-time {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
}

.update-text {
  font-size: 22rpx;
  color: #b0b5c0;
}

/* ========== 底部安全区 ========== */
.safe-bottom {
  height: 120rpx;
}

/* ========== 非交易时段 ========== */
.off-hours-bar {
  background: #2d3047;
  padding: 12rpx 0;
  display: flex;
  justify-content: center;
}

.off-hours-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}